#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if [ -n "${PYTHON_BIN:-}" ]; then
  PYTHON_CMD="$PYTHON_BIN"
elif [ -x ".venv/bin/python" ]; then
  PYTHON_CMD=".venv/bin/python"
else
  PYTHON_CMD="python3"
fi

API_HOST="${STOCKTRADE_API_HOST:-127.0.0.1}"
API_PORT="${STOCKTRADE_API_PORT:-8000}"
WEB_HOST="${STOCKTRADE_WEB_HOST:-127.0.0.1}"
WEB_PORT="${STOCKTRADE_WEB_PORT:-5173}"

if ! command -v node >/dev/null 2>&1; then
  echo "Missing node. Install Node.js 22, then run: nvm use" >&2
  exit 1
fi

NODE_MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || true)"
if [ "$NODE_MAJOR" != "22" ]; then
  echo "Unsupported Node.js $(node --version 2>/dev/null || echo unknown). StockTradebyZ requires Node.js 22.x; run: nvm use" >&2
  exit 1
fi

if [ ! -d "apps/web/node_modules" ]; then
  echo "Missing apps/web/node_modules. Run: cd apps/web && npm install" >&2
  exit 1
fi

if [ ! -f "apps/web/node_modules/vite/bin/vite.js" ]; then
  echo "Missing Vite CLI. Run: cd apps/web && npm install" >&2
  exit 1
fi

export PYTHONPATH="apps/api:src:${PYTHONPATH:-}"

cleanup() {
  if [ -n "${API_PID:-}" ] && kill -0 "$API_PID" 2>/dev/null; then
    kill "$API_PID" 2>/dev/null || true
  fi
  if [ -n "${WEB_PID:-}" ] && kill -0 "$WEB_PID" 2>/dev/null; then
    kill "$WEB_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

echo "Starting StockTradebyZ product API: http://${API_HOST}:${API_PORT}"
"$PYTHON_CMD" -m uvicorn stocktrade_api.main:app --host "$API_HOST" --port "$API_PORT" &
API_PID=$!

echo "Starting StockTradebyZ web app: http://${WEB_HOST}:${WEB_PORT}"
(
  cd apps/web
  node node_modules/vite/bin/vite.js --host "$WEB_HOST" --port "$WEB_PORT"
) &
WEB_PID=$!

echo "Product workstation ready: http://${WEB_HOST}:${WEB_PORT}"
echo "Press Ctrl+C to stop API and web servers."

while kill -0 "$API_PID" 2>/dev/null && kill -0 "$WEB_PID" 2>/dev/null; do
  sleep 1
done

wait "$API_PID" 2>/dev/null || true
wait "$WEB_PID" 2>/dev/null || true
