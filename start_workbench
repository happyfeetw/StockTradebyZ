#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

if [ "${STOCKTRADE_ALLOW_LEGACY_WORKBENCH:-}" != "1" ]; then
  echo "[ERROR] R7 workbench retirement: start_workbench is retired by default." >&2
  echo "Use ./start_product for supported React/FastAPI workflows." >&2
  echo "Temporary rollback: set STOCKTRADE_ALLOW_LEGACY_WORKBENCH=1 for migration, parity, or rollback checks." >&2
  echo "[WARN] R7 legacy write freeze: start_workbench is compatibility-only; use ./start_product for React/FastAPI workflows." >&2
  exit 2
fi

if [ -n "${TS_TOKEN:-}" ] && [ -z "${TUSHARE_TOKEN:-}" ]; then
  export TUSHARE_TOKEN="$TS_TOKEN"
fi

if [ -z "${TUSHARE_TOKEN:-}" ] && command -v zsh >/dev/null 2>&1; then
  ZSH_TUSHARE_TOKEN="$(zsh -ic 'print -r -- ${TUSHARE_TOKEN:-${TS_TOKEN:-}}' 2>/dev/null || true)"
  if [ -n "$ZSH_TUSHARE_TOKEN" ]; then
    export TUSHARE_TOKEN="$ZSH_TUSHARE_TOKEN"
  fi
fi

if [ -z "${GEMINI_API_KEY:-}" ] && command -v zsh >/dev/null 2>&1; then
  ZSH_GEMINI_API_KEY="$(zsh -ic 'print -r -- ${GEMINI_API_KEY:-}' 2>/dev/null || true)"
  if [ -n "$ZSH_GEMINI_API_KEY" ]; then
    export GEMINI_API_KEY="$ZSH_GEMINI_API_KEY"
  fi
fi

if [ ! -x ".venv/bin/streamlit" ]; then
  echo "Missing .venv/bin/streamlit. Run: .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

echo "[WARN] R7 legacy write freeze: start_workbench is compatibility-only; use ./start_product for React/FastAPI workflows." >&2

exec .venv/bin/streamlit run workbench/app.py \
  --server.port 8601 \
  --server.headless true \
  --theme.base light \
  --theme.backgroundColor '#f7f8fa' \
  --theme.secondaryBackgroundColor '#ffffff' \
  --theme.textColor '#20252b' \
  --theme.primaryColor '#1f6feb'
